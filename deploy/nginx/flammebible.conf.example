# Пример vhost для системного nginx перед контейнером.
# Подключается из http-контекста (sites-enabled). default_server здесь нет:
# на том же хосте могут работать другие имена.
#
# Сертификат — уже установленный wildcard. Отдельный выпуск Let's Encrypt
# для этого имени не нужен. Подставьте свои файлы вместо путей example.
# Строки options-ssl-nginx.conf и ssl-dhparams.pem — общие параметры TLS.

map $request_method $flamme_post_ip {
    POST    $binary_remote_addr;
    default "";
}

limit_req_zone $flamme_post_ip zone=flamme_register:10m rate=5r/m;
limit_req_zone $flamme_post_ip zone=flamme_login:10m rate=10r/m;
limit_req_zone $flamme_post_ip zone=flamme_refresh:10m rate=30r/m;

server {
    listen 80;
    listen [::]:80;
    server_name bible.example.com;
    server_tokens off;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name bible.example.com;
    server_tokens off;

    ssl_certificate     /etc/ssl/example/wildcard.crt;
    ssl_certificate_key /etc/ssl/example/wildcard.key;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # 8088 совпадает с FRONTEND_PORT. В compose порт открыт только на 127.0.0.1.
    client_max_body_size 1m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Strict-Transport-Security "max-age=15552000" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'" always;

    location = /register {
        limit_req zone=flamme_register burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8088;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /login {
        limit_req zone=flamme_login burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8088;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /refresh {
        limit_req zone=flamme_refresh burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8088;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:8088;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

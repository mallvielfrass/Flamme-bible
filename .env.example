# Пример переменных окружения. Скопируйте в .env и подставьте свои значения.
# Файл .env в git не попадает. Настоящих секретов здесь нет.

# PostgreSQL 16 или новее. Для docker compose эти три переменные собирают DATABASE_URL.
POSTGRES_USER=flammebible
POSTGRES_PASSWORD=change-me
POSTGRES_DB=flammebible

# Локальный запуск сервера без compose. Пароль с символами @ : / # нужно кодировать в URL.
DATABASE_URL=postgres://flammebible:change-me@127.0.0.1:5432/flammebible?sslmode=disable

# TLS необязателен. Если заданы оба файла, сервер слушает HTTPS.
# Если оба пустые, сервер слушает обычный HTTP (за обратным прокси).
# TLS_CERT=cert.pem
# TLS_KEY=key.pem

# Адрес listen, по умолчанию :8080
# ADDR=:8080

# Срок сессии. Обновляется при /refresh. Не короче 1m.
# SESSION_TTL=720h

# Каталог файлов на томе. В compose это /data/media.
# MEDIA_DIR=

# 1 — брать IP из X-Real-IP. Включать только за своим nginx, не на открытом порту.
# TRUST_PROXY=0

# Порт сайта на 127.0.0.1. Его же указывает deploy/nginx/flammebible.conf.example.
# FRONTEND_PORT=8088

# Прокси Vite. По умолчанию http://127.0.0.1:8080. Для локального TLS:
# VITE_API_TARGET=https://127.0.0.1:8080

# Необязательно: свой CA для CLI, если сервер с самоподписанным сертификатом
# FLAMMEBIBLE_CA=cert.pem

# Необязательно: каталог настроек CLI вместо ~/.config/flammebible
# FLAMMEBIBLE_CONFIG=/path/to/config

# Почта, которая при регистрации и входе получает role=admin.
# Пароль здесь не задаётся: его выбирают в запросе регистрации.
# В docker compose пустое значение никого не повышает.
# ADMIN_EMAIL=admin@example.com

# Каталог файлов релизов клиента. Сервер пишет только внутрь этого каталога.
# Локальный запуск бинарника: раскомментируйте путь на своей машине.
# RELEASES_DIR=/var/lib/flammebible/releases
# В docker compose каталог внутри контейнера фиксирован: /data/releases, том releases.

# Токен администратора для cmd/upload. Не коммитить настоящий токен.
# FLAMMEBIBLE_TOKEN=
# FLAMMEBIBLE_SERVER=https://api.example.com

# Смысловой поиск выключен, пока EMBED_URL пустой. Остальной сервер при этом работает.
# В Docker модель стартует отдельно. Раскомментируйте обе строки:
# COMPOSE_PROFILES=semantic
# EMBED_URL=http://embed:80/embed
# Локальный запуск без compose: EMBED_URL=http://127.0.0.1:8080/embed
# Модель rubert-tiny2: 312 чисел, пулинг CLS, без префиксов query/passage.
# Смена модели стирает старые векторы. После неё нужна команда go run ./cmd/reindex.
# EMBED_MODEL=cointegrated/rubert-tiny2
# Одно ядро и 768 МиБ. На старте модель занимает около 700 МиБ, потом около 200.
# EMBED_CPUS=1
# EMBED_MEMORY=768m

# Пример переменных окружения. Скопируйте в .env и подставьте свои значения.
# Файл .env в git не попадает.

# PostgreSQL 16.3
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/flammebible?sslmode=disable

# Пути к сертификату и ключу TLS (сервер без них не запускается)
TLS_CERT=cert.pem
TLS_KEY=key.pem

# Адрес API, по умолчанию :8080
# ADDR=:8080

# Для фронта в режиме разработки (прокси Vite), по умолчанию https://127.0.0.1:8080
# VITE_API_TARGET=https://127.0.0.1:8080

# Необязательно: свой CA для CLI, если сервер с самоподписанным сертификатом
# FLAMMEBIBLE_CA=cert.pem

# Необязательно: каталог настроек CLI вместо ~/.config/flammebible
# FLAMMEBIBLE_CONFIG=/path/to/config
